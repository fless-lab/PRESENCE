# Base de données (PostgreSQL en production, SQLite accepté pour les essais)
PRESENCE_BASE_URL=postgresql+psycopg://presence:presence@localhost:5432/presence
# Dossier des données locales : clé du serveur, secret des jetons, registre local
PRESENCE_DONNEES=./donnees
# Registre : "local" (simulation en fichier, sans Fabric) ou "fabric" (passerelle)
PRESENCE_REGISTRE=local
PRESENCE_REGISTRE_URL=http://localhost:8800
# Attestation de clé Android : "souple" (accepte l'absence de chaîne) ou "stricte"
PRESENCE_ATTESTATION=souple
# Origines autorisées pour le tableau de bord, séparées par des virgules
PRESENCE_CORS=http://localhost:5173
