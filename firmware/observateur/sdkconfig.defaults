# Bluetooth : NimBLE seul, BLE uniquement
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=9
# Limite du contrôleur propre à chaque puce : sdkconfig.defaults.esp32 et .esp32s3
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=185

# Cryptographie : ECDSA P-256
CONFIG_MBEDTLS_ECP_C=y
CONFIG_MBEDTLS_ECDSA_C=y
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# Tâches et taille du programme (Wi-Fi + NimBLE + mbedTLS dépassent 1 Mo)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
